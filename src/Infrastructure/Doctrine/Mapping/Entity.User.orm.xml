<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Entity\User" table="user">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="email" type="string" length="190" unique="true"/>
        <field name="passwordHash" type="string"/>
        <field name="roles" type="json"/>
        <field name="fullName" type="string"/>
        <field name="locale" type="string" length="2"/>
        <field name="totpSecret" type="string" nullable="true"/>
        <field name="recoveryCodes" type="json" nullable="true"/>
        <field name="mustChangePassword" type="boolean"/>
        <field name="createdAt" type="datetime_immutable"/>
        <field name="updatedAt" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
