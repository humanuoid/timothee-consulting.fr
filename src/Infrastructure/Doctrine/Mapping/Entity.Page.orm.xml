<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Entity\Page" table="page">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="createdAt" type="datetime_immutable"/>
        <field name="updatedAt" type="datetime_immutable"/>
        <many-to-one field="model" target-entity="App\Domain\Entity\PageModel">
            <join-column nullable="false" on-delete="RESTRICT"/>
        </many-to-one>
        <many-to-one field="createdBy" target-entity="App\Domain\Entity\User">
            <join-column nullable="false" on-delete="RESTRICT"/>
        </many-to-one>
        <many-to-one field="updatedBy" target-entity="App\Domain\Entity\User">
            <join-column nullable="true" on-delete="SET NULL"/>
        </many-to-one>
        <one-to-many field="contents" target-entity="App\Domain\Entity\PageContent" mapped-by="page"/>
    </entity>
</doctrine-mapping>
